# Copia este archivo a .env.local y completa los valores reales:
#   cp .env.example .env.local

# --- Supabase (obligatorias) ---
# Settings → API en tu proyecto de supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo para tareas server-side privilegiadas (no se expone al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# --- Sitio ---
# URL pública del sitio (usada en sitemap, robots y links de auth por correo)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Asistente IA "Mely" (Gemini) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Pagos (opcionales — la tienda funciona sin estas con pago contra entrega y transferencia) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
